# Example only. Store real values in Google Secret Manager; never commit real secrets.
ZORO_APP_ENV=production
ZORO_DATABASE_URL=postgresql+asyncpg://zoro:REPLACE_ME@/zoro?host=/cloudsql/PROJECT_ID:asia-south1:INSTANCE_NAME
ZORO_DATABASE_POOL_SIZE=5
ZORO_DATABASE_MAX_OVERFLOW=5
ZORO_JWT_SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ZORO_JWT_ACCESS_TTL_MINUTES=15
ZORO_REFRESH_TTL_DAYS=30
ZORO_OWNER_EMAIL=owner@example.com
ZORO_LIVE_CALLS_ENABLED=false
ZORO_LIVE_CALL_MAX_SECONDS=300
# Add these as Secret Manager references only after the provider is ready:
# ZORO_EXOTEL_STREAM_USERNAME
# ZORO_EXOTEL_STREAM_PASSWORD
# ZORO_OPENAI_API_KEY
